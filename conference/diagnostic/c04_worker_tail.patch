+    if (index >= C04_WORKER_TAIL_CAPACITY) {
+        atomic_fetch_add_explicit(
+            &c04_worker_tail.dropped_events, 1, memory_order_relaxed);
+        return NULL;
+    }
+    return &c04_worker_tail.events[index];
