+void ggml_cpu_worker_tail_trace_reset(void) {
+    atomic_store_explicit(&c04_worker_tail.active, false, memory_order_release);
+    atomic_store_explicit(&c04_worker_tail.event_count, 0, memory_order_relaxed);
+    atomic_store_explicit(&c04_worker_tail.dropped_events, 0, memory_order_relaxed);
+    atomic_store_explicit(&c04_worker_tail.epoch, 0, memory_order_relaxed);
