+
+void ggml_cpu_worker_tail_trace_begin(uint64_t epoch) {
+    atomic_store_explicit(&c04_worker_tail.epoch, epoch, memory_order_relaxed);
+    atomic_store_explicit(&c04_worker_tail.active, true, memory_order_release);
+}
+
+void ggml_cpu_worker_tail_trace_end(void) {
+    atomic_store_explicit(&c04_worker_tail.active, false, memory_order_release);
+}
