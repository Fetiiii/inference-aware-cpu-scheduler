# Local model files and links
/models

# llama.cpp is tracked as a submodule; keep local build trees out of this repo.
/llama.cpp/build/
/llama.cpp/build-*/

# Python and local tooling caches
__pycache__/
*.py[cod]
.pytest_cache/

# Locally compiled benchmark helpers
/harness/loadgen
/harness/membw

# Raw benchmark artifacts are large and reproducible from the harness.
/results/**/*.json
/results/**/*.log
/results/**/*.passes
/results/**/*.load
/results/**/*.serverlog

# JE AMD delivery: private authorization and one-session outputs are never public.
/.je_amd_authorization/
/results/journal_extension_amd_*/
/results/journal_extension_amd_*_private_*.zip
/results/journal_extension_amd_*_private_*.zip.sha256
# Include legacy coordinator _<segment>.zip names, scoped to JE only.
/results/journal_extension_amd_*.zip
/results/journal_extension_amd_*.zip.sha256
/results/.je_amd_runtime_*/
/private_history/
/AMD_JE_ONESESSION_APPROVED_PRIVATE.zip
/AMD_JE_ONESESSION_APPROVED_PRIVATE.zip.sha256
/AMD_journal_extension_oneshot_PREP*.zip
/AMD_journal_extension_oneshot_PREP*.zip.sha256
/execution_approval.json
/execution_approval.template.json
